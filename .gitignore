# RetroUX（公開版）の .gitignore

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
build/
dist/

# --- OS ---
.DS_Store
Thumbs.db

# --- ROM / セーブステート（★配布・コミット禁止）---
*.nes
*.rom
*.fds
*.unf
*.unif
*.nsf
*.fcs
*.sav
*.srm
*.state
*.fm2
*.fcm
*.fc[0-9]

# --- あなたの設定 ---
# ★user_config.yaml は同梱の初期設定として**追跡します**（すぐ使えるように）。
#   編集して使ってください（このリポジトリを更新しない限り git は静かです）。
# user_config.yaml   # ← 追跡するので無視しない

# --- 実行時データ（生成物・状態・ログ）---
work/*
output/
# ★ROM の置き場所の目印だけは残す（フォルダを git に作るため）
!work/rom/
work/rom/*
!work/rom/PLACE-ROM-HERE.txt

# --- エミュレータ（★各自で配置。同梱・コミットしない）---
tools/*
!tools/fceux/
tools/fceux/*
!tools/fceux/PLACE-FCEUX-HERE.txt
